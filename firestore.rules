rules_version = '2';

// Правила доступа к базе Calendar. Вставляются в Firebase Console →
// Firestore Database → Rules. Описание — docs/backend.md.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId;

      match /notifications/{id} {
        allow read, update, delete: if signedIn() && uid() == userId;
        allow create: if signedIn() && request.resource.data.fromUserId == uid();
      }
    }

    // Подписка: from подписывается на to. На закрытый профиль — только запрос.
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.from == uid()
        && id == uid() + '_' + request.resource.data.to
        && (request.resource.data.accepted == false
            || get(/databases/$(db)/documents/users/$(request.resource.data.to)).data.isPrivate != true);
      // Принять запрос может тот, на кого подписываются.
      allow update: if signedIn()
        && (resource.data.to == uid() || resource.data.from == uid())
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && (resource.data.to == uid() || request.resource.data.accepted == resource.data.accepted
            || get(/databases/$(db)/documents/users/$(resource.data.to)).data.isPrivate != true);
      allow delete: if signedIn() && (resource.data.from == uid() || resource.data.to == uid());
    }

    match /blocks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == uid();
      allow delete: if signedIn() && resource.data.from == uid();
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.from == uid();
    }

    // Записи «только я» видит лишь автор. «Подписчики» дополнительно
    // фильтруются в приложении.
    match /posts/{postId} {
      allow read: if signedIn()
        && (resource.data.authorId == uid()
            || resource.data.visibility in ['everyone', 'followers']);
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn()
        && ((resource.data.authorId == uid() && request.resource.data.authorId == uid())
            || onlyChanged(['likes', 'viewers']));
      allow delete: if signedIn() && resource.data.authorId == uid();

      match /comments/{id} {
        allow create: if signedIn() && request.resource.data.authorId == uid();
        allow update: if signedIn() && onlyChanged(['likes']);
        allow delete: if signedIn()
          && (resource.data.authorId == uid()
              || get(/databases/$(db)/documents/posts/$(postId)).data.authorId == uid());
      }
    }

    match /{path=**}/comments/{id} {
      allow read: if signedIn();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn() && uid() in request.resource.data.members;
      allow update: if signedIn() && uid() in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{id} {
        function members() {
          return get(/databases/$(db)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && uid() in members();
        allow create: if signedIn() && request.resource.data.senderId == uid()
          && uid() in members();
        allow update: if signedIn() && uid() in members() && onlyChanged(['read']);
      }
    }
  }
}
